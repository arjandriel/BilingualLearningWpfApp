<Window x:Class="BilingualImageApp.Wpf.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Afbeelding Voorbeeld" Height="400" Width="400">
    <Grid>
        <StackPanel>
            <Image x:Name="imgPreview" Height="300" Stretch="Uniform" Margin="0,0,0,10" />
            <Button x:Name="btnRotate" Content="Draaien" Click="BtnRotate_Click" Width="100" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>